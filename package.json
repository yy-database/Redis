{
    "private": true,
    "type": "module",
    "scripts": {
        "check": "cargo check --manifest-path projects/redis.rs/Cargo.toml --workspace",
        "build": "node scripts/build-platforms.mjs && pnpm --filter @yydb/redis build",
        "test": "cargo test --manifest-path projects/redis.rs/Cargo.toml --workspace --all-targets",
        "test:ts": "pnpm --filter @yydb/redis-harness test",
        "test:py": "node scripts/run-python-tests.mjs",
        "gate:drivers": "node scripts/gate-drivers.mjs",
        "gate:install:ts": "node scripts/gate-install-ts.mjs",
        "gate:install:py": "node scripts/gate-install-py.mjs",
        "gate:test-count:ts": "node scripts/check-test-floor.mjs --kind ts -- pnpm --filter @yydb/redis-harness test",
        "gate:test-count:py": "node scripts/check-test-floor.mjs --kind py -- node scripts/run-python-tests.mjs",
        "gate:conformance:compare": "node scripts/compare-conformance.mjs",
        "gate:oracle": "node projects/redis.ts/packages/redis-harness/bin/oracle.mjs",
        "gate:oracle:live": "node scripts/oracle-live.mjs --all",
        "gate:oracle:live:resp3": "node scripts/oracle-live.mjs command key-space keyspace-ops string-set-get object-encoding scan-contract zset-resp3 sort-ops bitfield-ops lpos-ops --protocol=3",
        "oracle:live": "node scripts/oracle-live.mjs"
    },
    "packageManager": "pnpm@10.18.3",
    "devDependencies": {
        "@doki-land/nifty": "^0.1.10",
        "express": "^5.3.0",
        "ioredis": "^6.0.0",
        "redis": "^6.3.1"
    }
}
